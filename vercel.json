{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/agente(.html)?", "destination": "/citas.html", "permanent": true },
    { "source": "/calendario(.html)?", "destination": "/multiespecialista.html", "permanent": true },
    { "source": "/conectores(.html)?", "destination": "/google-calendar.html", "permanent": true },
    { "source": "/cuadernos(.html)?", "destination": "/cotizaciones.html", "permanent": true },
    { "source": "/tareas(.html)?", "destination": "/crm.html", "permanent": true },
    { "source": "/reportes(.html)?", "destination": "/embudo.html", "permanent": true },
    { "source": "/flujos(.html)?", "destination": "/recordatorios.html", "permanent": true },
    { "source": "/mcp(.html)?", "destination": "/google-business.html", "permanent": true },
    { "source": "/modulos(.html)?", "destination": "/marketing-local.html", "permanent": true },
    { "source": "/seguimientos(.html)?", "destination": "/resenas.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
